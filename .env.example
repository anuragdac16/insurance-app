# Optional. Copy to .env to override the defaults used by docker-compose.yml:
#   cp .env.example .env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Apache Kafka image tag (KRaft mode, no ZooKeeper)
KAFKA_IMAGE_TAG=4.2.0

# Host port for Kafka clients running outside Docker (change if 9092 is already in use)
KAFKA_EXTERNAL_PORT=9092

# Delay between attempts to publish pending PostgreSQL outbox events
OUTBOX_POLL_INTERVAL_MS=1000
